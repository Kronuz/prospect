+// --- position blocks (P13) ---------------------------------------------------------------------
+
+// Built with PROSPECT_EXPERIMENT_P13, a full position block is today's bitpack block (FOR, PFOR or
+// constant) or, when smaller, Elias-Fano over the block's prefix sums S_i (i < 128):
+//   [0xC0 | l][zeros LEB128][lows: S_i's low l bits, bitpack at l][highs: unary, ceil((128 + zeros) / 8)]
+// where zeros = S_127 >> l and bit (S_i >> l) + i of the highs is set. Header 0xC0 | l is no bitpack
+// block (constant and exceptions together), so the codec rides in the header byte.
+#if PROSPECT_EXPERIMENT_P13
+inline constexpr std::uint8_t ef_flag = 0xC0;
+
+// For each byte value, the indexes of its set bits and how many there are.
+struct byte_bits {
+	std::uint8_t at[256][8];
+	std::uint8_t n[256];
+	constexpr byte_bits() : at{}, n{} {
+		for (unsigned v = 0; v < 256; ++v) {
+			std::uint8_t k = 0;
+			for (unsigned b = 0; b < 8; ++b) {
+				if (v >> b & 1) { at[v][k++] = std::uint8_t(b); }
+			}
+			n[v] = k;
+		}
+	}
+};
+inline constexpr byte_bits bits_of{};
+
+// Writes the block's smaller encoding into out; returns its size.
+inline std::size_t encode_position_block(const std::uint32_t* in, std::uint8_t* out) noexcept {
+	const std::size_t pfor = bitpack::encode_pfor(in, out);
+	std::uint64_t sum = 0;
+	for (std::size_t i = 0; i < block; ++i) { sum += in[i]; }
+	if (sum >> 32) { return pfor; }
+	unsigned l = 0;
+	std::uint64_t best = ~std::uint64_t(0);
+	for (unsigned w = 0; w < 32; ++w) {
+		const std::uint64_t zeros = sum >> w;
+		std::uint64_t leb = 1;
+		for (std::uint64_t z = zeros; z >= 128; z >>= 7) { ++leb; }
+		const std::uint64_t size = 1 + leb + bitpack::packed_bytes(w) + (block + zeros + 7) / 8;
+		if (size < best) { best = size, l = w; }
+	}
+	if (best >= pfor) { return pfor; }
+	std::uint32_t low[block];
+	const std::uint32_t mask = (1u << l) - 1;
+	const std::uint64_t zeros = sum >> l, bytes = (block + zeros + 7) / 8;
+	std::uint8_t* p = out;
+	*p++ = std::uint8_t(ef_flag | l);
+	for (std::uint64_t z = zeros;; z >>= 7) {
+		*p++ = std::uint8_t((z & 127) | (z >= 128 ? 128 : 0));
+		if (z < 128) { break; }
+	}
+	std::uint32_t s = 0;
+	std::uint8_t* high = p + bitpack::packed_bytes(l);
+	std::memset(high, 0, bytes);
+	for (std::size_t i = 0; i < block; ++i) {
+		s += in[i];
+		low[i] = s & mask;
+		const std::uint64_t at = (s >> l) + i;
+		high[at >> 3] = std::uint8_t(high[at >> 3] | (1u << (at & 7)));
+	}
+	bitpack::pack(low, l, p);
+	return std::size_t(high + bytes - out);
+}
+
+// The size of the position block at in, from its headers; 0 when malformed or truncated.
+inline std::size_t position_block_size(const std::uint8_t* in, std::size_t size) noexcept {
+	if (size < 2 || (in[0] & ef_flag) != ef_flag) { return bitpack::encoded_size(in, size); }
+	const unsigned l = in[0] & 0x3f;
+	if (l >= 32) { return 0; }
+	std::uint64_t zeros = 0;
+	std::size_t at = 1;
+	for (unsigned sh = 0;; sh += 7) {
+		if (at >= size || sh > 28) { return 0; }
+		const std::uint8_t b = in[at++];
+		zeros |= std::uint64_t(b & 127) << sh;
+		if (b < 128) { break; }
+	}
+	if ((zeros << l) >> 32) { return 0; }
+	const std::uint64_t total = at + bitpack::packed_bytes(l) + (block + zeros + 7) / 8;
+	return total <= size ? std::size_t(total) : 0;
+}
+
+// Decodes the position block at in into its 128 values; returns the bytes read, 0 when malformed.
+inline std::size_t decode_position_block(const std::uint8_t* in, std::size_t size, std::uint32_t* out) noexcept {
+	if (size < 1 || (in[0] & ef_flag) != ef_flag) { return bitpack::decode(in, size, out); }
+	const std::size_t total = position_block_size(in, size);
+	if (!total) { return 0; }
+	const unsigned l = in[0] & 0x3f;
+	const std::uint8_t* p = in + 1;
+	while (*p++ & 128) {}
+	std::uint32_t low[block], at[block + 8];
+	bitpack::unpack(p, l, low);
+	const std::uint8_t* high = p + bitpack::packed_bytes(l);
+	const std::size_t bytes = std::size_t(in + total - high);
+	std::uint32_t n = 0;
+	for (std::size_t k = 0; k < bytes; ++k) {
+		const std::uint8_t v = high[k];
+		if (n >= block) {
+			if (v) { return 0; }  // a 129th set bit
+			continue;
+		}
+		const std::uint32_t base = std::uint32_t(8 * k);
+		for (unsigned j = 0; j < 8; ++j) { at[n + j] = base + bits_of.at[v][j]; }
+		n += bits_of.n[v];
+	}
+	if (n != block) { return 0; }
+	std::uint32_t sum[block + 1];
+	sum[0] = 0;
+	for (std::uint32_t j = 0; j < block; ++j) { sum[j + 1] = (at[j] - j) << l | low[j]; }
+	for (std::uint32_t j = 0; j < block; ++j) { out[j] = sum[j + 1] - sum[j]; }
+	return total;
+}
+#endif
+
