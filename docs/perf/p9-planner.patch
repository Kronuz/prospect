+	// The 4,096-ordinal window holding d: skipped when the summed bounds cannot compete, else
+	// its matches come from cnt's fill (window bits ANDed, or probes) and only they are scored.
+	// Returns cnt's next match.
+	ordinal_t collect_window(top_collector& c, scorer& cnt, ordinal_t d) {
+		const std::size_t n = terms_.size();
+		const ordinal_t base = d & ~ordinal_t(4095), end = base > no_more_docs - 4096 ? no_more_docs : base + 4096;
