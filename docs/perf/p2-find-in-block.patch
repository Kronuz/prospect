@@ -1387,7 +1387,46 @@ private:
 	// (targets are usually close); a long remainder is bisected branch-free; a short one is
 	// compared whole from its 16-slot row, branch-free so the loop vectorizes (the slots past
 	// buf_len_ hold no_more_docs).
+#ifndef PROSPECT_EXPERIMENT_FIB
+#define PROSPECT_EXPERIMENT_FIB 0
+#endif
 	std::size_t find_in_block(ordinal_t target) const noexcept {
+#if PROSPECT_EXPERIMENT_FIB == 9
+		// Reference: every slot compared from 0 (5227e00).
+		std::uint32_t n = 0;
+		for (std::size_t i = 0; i < format::block; ++i) { n += std::uint32_t(buf_ords_[i] < target); }
+		return n;
+#elif PROSPECT_EXPERIMENT_FIB
+		const std::size_t first = pos_ + 1;
+		std::size_t p = first;
+#if PROSPECT_EXPERIMENT_FIB >= 2
+		// Expected slots to target at the remainder's mean gap, division-free: under 4 when
+		// (target - doc) * remaining slots < 4 * remaining span. Far targets skip the probes.
+		const std::uint64_t span = std::uint64_t(buf_ords_[buf_len_ - 1] - buf_ords_[pos_]);
+		if (std::uint64_t(target - buf_ords_[pos_]) * (buf_len_ - first) < 4 * span)
+#endif
+		{
+			const std::size_t probes = std::min<std::size_t>(first + 4, buf_len_);
+			for (; p < probes; ++p) {
+				if (buf_ords_[p] >= target) { return p; }
+			}
+		}
+		const std::size_t end = (buf_len_ + 15) & ~std::size_t(15);
+#if PROSPECT_EXPERIMENT_FIB == 3
+		// 32-slot windows from the row: the first whose last slot reaches target is compared.
+		std::size_t row = p & ~std::size_t(15);
+		while (row + 32 < end && buf_ords_[row + 31] < target) { row += 32; }
+		row = std::min<std::size_t>(row, format::block - 32);
+		std::uint32_t n = 0;
+		for (std::size_t i = 0; i < 32; ++i) { n += std::uint32_t(buf_ords_[row + i] < target); }
+		return row + n;
+#else
+		const std::size_t row = p & ~std::size_t(15);
+		std::uint32_t n = 0;
+		for (std::size_t i = row; i < end; ++i) { n += std::uint32_t(buf_ords_[i] < target); }
+		return row + n;
+#endif
+#else
 		const std::size_t first = pos_ + 1, probes = std::min<std::size_t>(first + 4, buf_len_);
 		for (std::size_t p = first; p < probes; ++p) {
 			if (buf_ords_[p] >= target) { return p; }
@@ -1405,6 +1444,7 @@ private:
 		std::uint32_t n = 0;
 		for (std::size_t i = row; i < end; ++i) { n += std::uint32_t(buf_ords_[i] < target); }
 		return row + n;
+#endif
 	}
 
