+#if PROSPECT_EXPERIMENT_P7 & 1
+// P7 experiment: the excluded clauses of a top-k over one term, probed only for hits that could
+// enter; a step back in ordinals (a reordered segment's groups) restarts them from fresh copies.
+struct exclusion_probe {
+	std::vector<const scorer*> base;
+	std::vector<scorer_ptr> cur;
+	std::vector<char> started;
+	ordinal_t last = 0;
+	bool add(const scorer* e) {
+		auto f = e->fresh();
+		if (!f) { return false; }
+		base.push_back(e), cur.push_back(std::move(f)), started.push_back(0);
+		return true;
+	}
+	bool excluded(ordinal_t d) {
+		if (d < last) {
+			for (std::size_t i = 0; i < cur.size(); ++i) { cur[i] = base[i]->fresh(), started[i] = 0; }
+		}
+		last = d;
+		for (std::size_t i = 0; i < cur.size(); ++i) {
+			scorer& e = *cur[i];
+			if (!started[i] || e.doc() < d) {
+				started[i] = 1;
+				e.advance(d);
+			}
+			if (e.doc() == d) { return true; }
+		}
+		return false;
+	}
+};
+#endif
